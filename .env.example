# AWS Configuration
# Backend cần setup các giá trị này trong AWS Cognito và cung cấp cho frontend
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_S3_BUCKET_NAME=malware-analysis-bucket-xxxx
VITE_IDENTITY_POOL_ID=ap-southeast-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cognito Domain (để trống nếu không dùng OAuth)
VITE_COGNITO_DOMAIN=

# Redirect URLs
VITE_REDIRECT_SIGN_IN=http://localhost:3000/
VITE_REDIRECT_SIGN_OUT=http://localhost:3000/login
